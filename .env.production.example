APP_NAME=WANUWIN
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-domain-kamu.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Vercel: stderr agar log masuk ke Vercel Runtime Logs (filesystem ephemeral)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Supabase / Postgres — JANGAN commit secret asli.
# Ambil dari Supabase Dashboard > Settings > Database > Connection string.
# Gunakan port 5432 untuk session mode (default Laravel),
# atau 6543 untuk transaction mode (perlu set DB_SSLMODE=require).
# Contoh tanpa password (ganti isi di dashboard hosting, bukan di repo):
DB_CONNECTION=pgsql
DB_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DB_SSLMODE=require
# Atau pakai variabel terpisah (salah satu saja, DB_URL mengalahkan di bawah):
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.PROJECT_REF
# DB_PASSWORD=

# Supabase Storage — tempat foto (berita, galeri, carousel, pengurus, anggota)
# disimpan agar permanen & bisa diakses publik. Filesystem Vercel ephemeral.
# Ambil service_role di Supabase Dashboard > Settings > API (RAHASIA, jangan commit).
# Bila kosong, foto jatuh ke disk lokal dan TIDAK tampil di Vercel.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wanuwin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Vercel: sync karena tidak ada worker yang jalan terus-menerus.
# Kalau mau queue database, perlu Daemon/worker terpisah.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
